# Copy to the same filename without .example; see README.md.
data:
  corpus: data/corpus/vul/clustered_rag_data.jsonl
  query: data/query/black/target/poison_targets_set_v4.json
database:
  model: configs/models/harrier-oss-v1-0.6b.yml
  uri: data/milvus/vul/harrier-oss-v1-0.6b.db
  collection_name: vul
retrieval:
  dense_index_type: AUTOINDEX
  dense_metric_type: COSINE
  dense_index_params:
    M: 16
    efConstruction: 256
  top_k: 10
  retrieval_strategy: dense
  cluster_search: false
  alpha_weight: 0.5
