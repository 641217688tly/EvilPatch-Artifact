# Copy to the same filename without .example; see README.md.
data:
  corpus: data/query/black/query_set.jsonl
  query: data/corpus/vul/clustered_rag_data.jsonl
database:
  model: configs/models/harrier-oss-v1-0.6b.yml
  uri: data/milvus/bfp/query/black/harrier-oss-v1-0.6b.db
  collection_name: bfp
retrieval:
  dense_index_type: AUTOINDEX
  dense_metric_type: COSINE
  dense_index_params:
    M: 16
    efConstruction: 256
  top_k: 10
  retrieval_strategy: dense
  alpha_weight: 0.5
  query_target: vul_code
