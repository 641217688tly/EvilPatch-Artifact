# Copy to the same filename without .example; see README.md.
data:
  corpus: data/corpus/bfp/rag_data.jsonl
  query: data/query/black/test/test_query_set_v4.json
database:
  model: configs/models/gte-modernbert-base.yml
  uri: data/milvus/bfp/apr/gte-modernbert-base.db
  collection_name: bfp
retrieval:
  dense_index_type: AUTOINDEX
  dense_metric_type: COSINE
  dense_index_params:
    M: 16
    efConstruction: 256
  top_k: 15
  retrieval_strategy: dense
  alpha_weight: 0.5
  query_target: buggy_code
