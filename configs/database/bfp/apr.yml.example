# 执行文件: src/evaluation/retrieval/retrieva_attack_eval.ipynb

# 数据路径
data:
  corpus: "data/corpus/bfp/rag_data.jsonl" # 知识库数据集

  query: "data/query/black/test/test_query_set_v4.json" # 注意，需要按照CWE进行分区

# 数据库配置
database:
  # model: "configs/models/gte-modernbert-base.yml" # 受害模型
  # uri: "data/milvus/bfp/apr/gte-modernbert-base.db" # 受害向量库路径

  model: "configs/models/jina-code-embeddings-0.5b.yml" # 受害模型
  uri: "data/milvus/bfp/apr/jina-code-embeddings-0.5b.db" # 受害向量库路径

  collection_name: "bfp" # Milvus数据库内的集合名称（等同于Mysql的表名）


# 检索配置
retrieval:
  dense_index_type: "AUTOINDEX" # 密集向量索引类型：自动索引
  dense_metric_type: "COSINE" # 密集向量距离度量类型：余弦相似度
  dense_index_params: {"M": 16, "efConstruction": 256} # 密集向量索引参数：M为每个节点存储的邻居数量，efConstruction为搜索时考虑的邻居数量
  
  top_k: 15 # 召回数量
  # top_k: 10 # 召回数量，仅在data_prep阶段设置为10，在评估阶段需要改为消融实验所需的top-k
  retrieval_strategy: "dense" # 检索策略：hybrid(混合检索)、dense(密集检索)、sparse(稀疏检索)、all(密集检索+稀疏检索+混合检索)
  alpha_weight: 0.5 # 混合检索的权重, 仅在 retrieval_strategy 为 hybrid 时生效, 0.5表示50%的权重给密集向量, 50%的权重给稀疏向量
  query_target: "buggy_code" # 用于选择BFP的查询目标字段，可选项为：fixed_code、buggy_code