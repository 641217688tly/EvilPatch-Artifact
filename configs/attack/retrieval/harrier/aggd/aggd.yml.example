# Copy to the same filename without .example; see README.md.
logging:
  verbose: false
  log_dir: logs/retrieval_attack
  log_every_n_iter: 1
data:
  target_file_path: data/query/black/target/harrier/aggd.json
model:
  retriever_config: configs/models/harrier-oss-v1-0.6b.yml
  device_selection:
    mode: exclusive
    occupied_policy: any_process
    on_busy: wait
    poll_interval_seconds: 10
    wait_timeout_seconds: 300
    min_free_memory_mb: 20000
    max_idle_memory_used_mb: 512
    lock_dir: null
  device_pool:
  - cuda:0
sampling:
  process_cwe:
  - CWE-787
  - CWE-416
  - CWE-125
  - CWE-476
  - CWE-20
  - CWE-200
  - CWE-119
  - CWE-362
  min_condidate_num: 0
  max_condidate_num: 6000
attack:
  optimizer: aggd
  loss_func: expected_sim
  dynamic_weight: false
  scaling_factor: 1.0
  N: 50
  n: 4000
  patience: 10
  tau_stop: 0.95
  similarity_metric: cosine
  seed: 42
