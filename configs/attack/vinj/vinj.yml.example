# Copy to the same filename without .example; see README.md.
logging:
  verbose: false
  debug_dir: logs/vinj_attack
data:
  cwe_file_path: data/raw/cwe/cwec_v4.19.1.xml
  cve_file_path: data/raw/cwe/CVE_v2026.03.18.json
  target_file_path: data/query/black/target/gte/gpbs.json
  cache_folder_path: data/cache/generation_attack
model:
  vinj_generator_config: configs/models/deepseek-v4.1-flash.yml
  judge_generator_config: configs/models/deepseek-v4.1-flash.yml
  reranker_generator_config: configs/models/deepseek-v4.1-flash.yml
  retriever_config: configs/models/harrier-oss-v1-0.6b.yml
database:
  clear_cache: false
  milvus_config: configs/database/vul/vinj.yml
vinj:
  enable_cache: false
  top_k: 10
  skip_rerank: true
  relevant_vul_num: 5
  judge_max_retries: 5
  num_workers: null
  process_cwe:
  - CWE-787
  - CWE-416
  - CWE-125
  - CWE-476
  - CWE-20
  - CWE-200
  - CWE-119
  - CWE-362
  process_num: null
