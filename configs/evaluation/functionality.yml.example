# Copy without .example; finalize targets before evaluation.
data:
  retrieval_dir_path: data/query/black/test/results/gte-modernbert-base/abgs-<RUN_ID>
database:
  milvus_config: configs/database/bfp/apr.yml
model:
  apr_generator_config: configs/models/deepseek-v4-flash.yml
eval:
  eval_cwe:
  - CWE-787
  - CWE-416
  - CWE-125
  - CWE-476
  - CWE-20
  - CWE-200
  - CWE-119
  - CWE-362
  eval_top_k:
  - 15
  eval_mode: both
  eval_jailbreak_ablation: false
  crystalbleu_k: 500
  crystalbleu_corpus_path: data/corpus/bfp/rag_data.jsonl
  crystalbleu_corpus_field: fixed_code
  crystalbleu_cache_dir: data/cache/crystalbleu
  max_ref_chars: 0
  max_prompt_chars: 0
  max_retries: 5
  num_workers: null
  process_num: null
  eval_retrieval_strategy: dense
  clear_racg_results: false
  clear_bleu_results: false
  result_lock_timeout: 120.0
