# python -m src.evaluation.functionality.functionality_consistency_eval --config configs/evaluation/functionality.yml
# ── 数据路径 ──────────────────────────────────────────────────
data:
  # 指向检索评估生成的分钟级时间戳运行目录；读取 poisoned/，并生成或复用 clean/

  # Experiment1 - Main Result
  # GTE
  retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/gte-modernbert-base/abgs-2026-09-22-22-32"
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/gte-modernbert-base/pabs-2026-09-22-22-45"
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/gte-modernbert-base/aggd-2026-09-22-22-55"
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/gte-modernbert-base/naive-2026-09-22-23-06"

  # Harrier
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/harrier-oss-v1-0.6b/abgs-2026-09-22-23-15"
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/harrier-oss-v1-0.6b/pabs-2026-09-22-23-25"
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/harrier-oss-v1-0.6b/aggd-2026-09-22-23-34"
  # retrieval_dir_path: "data/query/black/test/results/Experiment1-Main Results/harrier-oss-v1-0.6b/naive-2026-09-22-23-45"


  # Experiment2 - CWE-wise Attack Effectiveness
  # GTE
  # retrieval_dir_path: "data/query/black/test/results/Experiment2-CWE-wise Attack Effectiveness/gte-modernbert-base/abgs-2026-09-22-22-32"

  # Harrier
  # retrieval_dir_path: "data/query/black/test/results/Experiment2-CWE-wise Attack Effectiveness/harrier-oss-v1-0.6b/abgs-2026-09-22-23-15"



# ── 纯净 APR 向量知识库 ──────────────────────────────────────
database:
  milvus_config: "configs/database/bfp/apr.yml"

# ── 模型配置 ─────────────────────────────────────────────────
model:
  # apr_generator_config: "configs/models/deepseek-v4-flash.yml" # 受害生成器
  # apr_generator_config: "configs/models/qwen3.7-flash.yml" # 受害生成器
  apr_generator_config: "configs/models/mimo-v2.6-flash.yml" # 受害生成器
  # apr_generator_config: "configs/models/glm-5.3-flash.yml" # 受害生成器


# ── 评估相关 ─────────────────────────────────────────────────
eval:
  eval_cwe: ["CWE-787", "CWE-416", "CWE-125", "CWE-476", "CWE-20", "CWE-200", "CWE-119", "CWE-362"] # 待评估的目标 CWE 列表
  eval_top_k: [15]

  eval_mode: "mixed" # per_cwe=仅逐 CWE；mixed=仅 CWE-MIXED；both=两者；eval_cwe仅为CWE-MIXED时自动使用mixed
  
  # eval_jailbreak_ablation: True # True=仅评估无越狱注释的 *_jailbreak_ablation.json
  eval_jailbreak_ablation: False # False=评估含越狱注释的 poisoned 原文件

  crystalbleu_k: 500
  crystalbleu_corpus_path: "data/corpus/bfp/rag_data.jsonl"
  crystalbleu_corpus_field: "fixed_code"
  crystalbleu_cache_dir: "data/cache/crystalbleu"

  # APR 提示词长度预算（防止触发远端 API 输入长度上限，如 Aliyun MaaS 的 204800 token）
  max_ref_chars: 0       # 单条检索参考 buggy/fixed 代码的最大字符数（0 表示不截断）
  max_prompt_chars: 0  # 整段提示词的最大字符数，超出则从尾部丢弃参考（0 表示不限制）
 
  max_retries: 5
  num_workers: null # RACG并发数；null=APR模型api_pool大小，否则取配置值与池大小的较小值
  process_num: null
  eval_retrieval_strategy: "dense"
  # 仅清理所选 CWE 的 clean 文件中指定 Top-k、当前生成器的槽位；同时为 true 时以 RACG 清理为准。
  # 清理完成后若需断点续跑，请将开关改回 false，避免每次启动重复清理。
  # 逐条进度暂存于 clean/.functionality_progress，clean 与 poisoned 写回成功后自动清除。
  clear_racg_results: false # 删除 clean 的 prompt、patch、CrystalBLEU，重新生成与评分
  clear_bleu_results: false # 仅删除 clean 的 CrystalBLEU，复用补丁重新评分
  result_lock_timeout: 120.0 # 并发读写同一结果 JSON 的文件锁等待上限（秒）
