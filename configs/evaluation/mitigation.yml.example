# Copy without .example; finalize targets before evaluation.
data:
  poisoned_file_path: data/query/black/target/gte/gpbs_final.json
  target_query_file: data/query/black/unsafe_query_set_v4.json
  detector_cache_dir: data/cache/detectors
database:
  milvus_config: configs/database/bfp/apr.yml
eval_index:
  eval_cwe:
  - CWE-787
  - CWE-416
  - CWE-125
  - CWE-476
  - CWE-20
  - CWE-200
  - CWE-119
  - CWE-362
  eval_mode: both
  detector:
    beta: 0.01
    quantile: 0.95
    normalize_embeddings: true
    force_rebuild: false
