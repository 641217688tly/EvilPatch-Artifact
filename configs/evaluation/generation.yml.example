# Copy without .example; finalize targets before evaluation.
data:
  poisoned_file_path: data/query/black/target/gte/gpbs_final.json
  retrieval_dir_path: data/query/black/test/results/gte-modernbert-base/abgs-<RUN_ID>
database:
  milvus_config: configs/database/vul/vinj.yml
model:
  apr_generator_config: configs/models/deepseek-v4-flash.yml
  judge_generator_config: configs/models/deepseek-v4.1-flash.yml
eval:
  eval_jailbreak_ablation: false
  eval_top_k:
  - 15
  eval_mode: both
  eval_cwe:
  - CWE-787
  - CWE-416
  - CWE-125
  - CWE-476
  - CWE-20
  - CWE-200
  - CWE-119
  - CWE-362
  eval_retrieval_strategy: dense
  max_ref_chars: 0
  max_prompt_chars: 0
  max_retries: 5
  num_workers: null
  judge_num_workers: null
  process_num: null
  result_lock_timeout: 120.0
  clear_racg_results: false
  clear_judge_results: false
