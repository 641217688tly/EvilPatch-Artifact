# python -m src.evaluation.debug.generation_debug_eval --config configs/evaluation/debug.yml

# 本实验在相同 query、相同有毒 doc_id 多重集合下比较多个检索攻击方法。
# 仅从每个 retrieval_dir_path/poisoned 中读取基础的
# {CWE}_alpha_{A}_target_{T}_test_{Q}_retrieval_results.json，派生文件不会被再次当作输入。
#
# 不同 eval_recall_strategy 使用相互独立的断点续跑文件：
#   eval_jailbreak_ablation=false:
#     *_retrieval_results_{strategy}_debug.json
#   eval_jailbreak_ablation=true:
#     *_retrieval_results_jailbreak_ablation_{strategy}_debug.json
#
# 日志按优化器分别保存：
# logs/evaluation/generation/{embedder}-{optimizer}/{generator}-{timestamp}/
#   {jailbreak|naive}/{strategy}/top-{K}/
#   {CWE}_alpha_{A}_target_{T}_test_{Q}_generation_eval_debug.txt
# 同一 {jailbreak|naive}/{strategy} 目录下生成 overview_debug.md。

# ── 数据路径 ──────────────────────────────────────────────────
data:
  # 至少配置两个待比较方法；每项必须指向该方法的投毒文件和同一次检索评估结果目录。
  ablation:
    - poisoned_file_path: "data/query/black/target/gte/merged/Naive/poison_targets_set_v4_intersected.json"
      retrieval_dir_path: "data/query/black/test/results/gte-modernbert-base/naive-2026-07-22-04-11"
    - poisoned_file_path: "data/query/black/target/gte/merged/ABGS/poison_targets_set_v4_merged_intersected.json"
      retrieval_dir_path: "data/query/black/test/results/gte-modernbert-base/abgs-2026-07-22-04-19"
    - poisoned_file_path: "data/query/black/target/gte/merged/PABS/poison_targets_set_v4_merged_intersected.json"
      retrieval_dir_path: "data/query/black/test/results/gte-modernbert-base/pabs-2026-07-22-04-34"

database:
  milvus_config: "configs/database/vul/vinj.yml"

# ── 模型配置 ─────────────────────────────────────────────────
model:
  apr_generator_config: "configs/models/deepseek-v4-flash.yml" # 受害生成器
  # apr_generator_config: "configs/models/gpt-5-mini.yml" # 受害生成器
  # apr_generator_config: "configs/models/qwen3-coder-30b-a3b-instruct.yml" # 受害生成器

  judge_generator_config: "configs/models/deepseek-v4-pro.yml"

# ── 评估相关 ─────────────────────────────────────────────────
eval:

  eval_top_k: [5, 10, 15]

  # per_cwe=仅逐 CWE；mixed=仅 CWE-MIXED；both=逐 CWE + CWE-MIXED
  eval_mode: "both"
  
  # poison_only：仅保留有毒 BFP
  # overlap_recall：保留有毒 BFP 和各方法共同召回的无毒 BFP
  # all：保留每个方法自己的完整 Top-K
  eval_recall_strategy: "poison_only"
  
  # False=评估含越狱注释的 poisoned 结果，日志模式为 jailbreak
  # True=关闭越狱注释：使用 vinj_attack.vul_code 替换有毒命中的 fixed_code，日志模式为 naive
  eval_jailbreak_ablation: true

  eval_cwe: ["CWE-787", "CWE-416", "CWE-125", "CWE-476", "CWE-20", "CWE-200", "CWE-119", "CWE-362"]

  eval_retrieval_strategy: "dense"

  # APR 提示词长度预算（防止触发远端 API 输入长度上限，如 Aliyun MaaS 的 204800 token）
  max_ref_chars: 0       # 单条检索参考 buggy/fixed 代码的最大字符数（0 表示不截断）
  max_prompt_chars: 0  # 整段提示词的最大字符数，超出则从尾部丢弃参考（0 表示不限制）

  max_retries: 5
  num_workers: null
  process_num: null
  
