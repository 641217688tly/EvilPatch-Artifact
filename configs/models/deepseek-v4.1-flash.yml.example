model_name: "deepseek-ai/Deepseek-V4.1-Flash"   
temperature: 0                              # 生成温度（0.0 确定性输出，1.0 高创造性）
max_tokens: 100000                             # 默认最大生成 token 数
retry_num: 1                                  # API 调用失败时的重试次数（封装层重试）
timeout: 300.0                                # 单次 HTTP 请求超时时间（秒，须为正数）

api_pool:
  - api_key: sk-
    base_url: "https://api.deepseek.com"
    model_name: "deepseek-flash"
