model_name: "gpt-5-mini"    # 模型名称
temperature: 0 # 生成温度（0.0 确定性输出，1.0 高创造性）
max_tokens: 65536 # 默认最大生成 token 数
retry_num: 3   # API 调用失败时的重试次数（封装层重试，SDK 内置重试后继续）                      # 模型名称
timeout: 300.0 # 单次 HTTP 请求超时时间（秒，须为正数）
api_pool:
  - api_key: "sk-xx"
    base_url: "https://api.laozhang.ai/v1"
  - api_key: "sk-xx"
    base_url: "https://api.laozhang.ai/v1"
temperature: 0.5                                 # 生成温度（0.0 确定性输出，1.0 高创造性）
max_tokens: 65536                                 # 默认最大生成 token 数